# Cluster gateway. Traefik terminates TLS and routes /api and the tile host here;
# requests pass Caddy :80 → Varnish :8000 → Caddy :8080, all in one pod.
{
	servers {
		# Traefik is on the pod network. Strict: the rightmost untrusted address
		# is the client, since entries to its left are the client's to forge.
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

import routes.caddy
import tiles.caddy

:80 {
	@tile_host host {$GATEWAY_TILE_HOSTS:tiles.macrostrat.org}
	handle @tile_host {
		import tile-edge localhost:8000
	}

	handle {
		import api-edge localhost:8000
	}

	log {
		output stdout
		format console
	}

	# Don't set server header
	header /* {
		-Server
		-X-Powered-By

		# Set CORS headers if they are not already set
		?Access-Control-Allow-Origin *
		?Access-Control-Allow-Methods GET,POST,OPTIONS,PUT,PATCH,DELETE
		?Access-Control-Allow-Headers X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,Range-Unit,Content-Range
	}
}

# Handler for requests post-Varnish.
:8080 {
	import api-routes
}
